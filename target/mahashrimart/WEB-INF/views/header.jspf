<%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %>
<%@ taglib prefix="fmt" uri="http://java.sun.com/jsp/jstl/fmt" %>
<!doctype html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><c:out value="${pageTitle}" default="MahashriMart"/></title>
    <link rel="stylesheet" href="<c:out value='${pageContext.request.contextPath}'/>/static/css/app.css">
</head>
<body>
<header class="site-header">
    <div class="container nav-shell">
        <a class="brand" href="<c:out value='${pageContext.request.contextPath}'/>/">
            <span class="brand-mark">M</span>
            <span>MahashriMart</span>
        </a>
        <nav class="nav-links" aria-label="Main navigation">
            <a href="<c:out value='${pageContext.request.contextPath}'/>/">Marketplace</a>
            <c:if test="${not empty sessionScope.user and sessionScope.user.role == 'BUYER'}">
                <a href="<c:out value='${pageContext.request.contextPath}'/>/orders">Orders</a>
                <a class="cart-link" href="<c:out value='${pageContext.request.contextPath}'/>/cart">Cart</a>
            </c:if>
            <c:if test="${not empty sessionScope.user and sessionScope.user.role == 'SELLER'}">
                <a href="<c:out value='${pageContext.request.contextPath}'/>/seller/products/new">Sell a product</a>
            </c:if>
        </nav>
        <div class="nav-account">
            <c:choose>
                <c:when test="${not empty sessionScope.user}">
                    <span class="welcome">Hi, <c:out value="${sessionScope.user.name}"/></span>
                    <a class="button button-small button-ghost" href="<c:out value='${pageContext.request.contextPath}'/>/logout">Log out</a>
                </c:when>
                <c:otherwise>
                    <a class="button button-small button-ghost" href="<c:out value='${pageContext.request.contextPath}'/>/login">Log in</a>
                    <a class="button button-small" href="<c:out value='${pageContext.request.contextPath}'/>/register">Join</a>
                </c:otherwise>
            </c:choose>
        </div>
    </div>
</header>
<main>