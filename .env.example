# MahashriMart configuration (example values only, no real secrets here)
#
# The app reads these as ENVIRONMENT VARIABLES. All of them are optional.
# If a value is not set, the default shown below is used.
# Copy this file to ".env" for your own notes. The real ".env" must never be committed.
#
# To set one in PowerShell before starting the site, for example:
#   $env:AI_CHATBOT_PROVIDER = "mock"

# Port the embedded server listens on (default: 8080)
PORT=8080

# Database connection (default: in-memory H2, data resets on restart)
MAHASHRIMART_DB_URL=jdbc:h2:mem:mahashrimart;DB_CLOSE_DELAY=-1;MODE=PostgreSQL
MAHASHRIMART_DB_USER=sa
MAHASHRIMART_DB_PASSWORD=

# Chatbot provider: "mock" (canned answers, no internet) or "gemini" (real API)
AI_CHATBOT_PROVIDER=mock

# Needed only when AI_CHATBOT_PROVIDER=gemini. Keep the real key on the server only.
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-flash-latest